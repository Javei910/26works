# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Airtable
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id

# Cloudflare R2 / S3
S3_BUCKET_NAME=vinylflow-assets
S3_REGION=auto
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://your-bucket.your-domain.com

# Kunaki
KUNAKI_EMAIL=your_kunaki_email
KUNAKI_PASSWORD=your_kunaki_password

# WooCommerce
WOOCOMMERCE_API_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret

# n8n
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/vinylflow
N8N_API_KEY=your_n8n_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
