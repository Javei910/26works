#import "../template.typ": somatic_page

// PHASE 1 - PAGE 14: RITUAL - Grounding Practice
// Gold box formatting per Layout Architect

#somatic_page(
  title: "Ritual: The Grounding Sequence",
  body_text: [
    This ritual is your foundation. Practice it before every phase, whenever you feel dysregulated, or any time you need to return to your window of tolerance.
    
    #v(0.5cm)
    
    #rect(stroke: 0.5pt + rgb("#D4AF37"), inset: 20pt, width: 100%)[
      #align(center)[*The Grounding Sequence*]
      
      1.  *Find your feet.* Stand or sit. Press your feet into the floor. Feel the earth beneath you. Say aloud: "I am held."
      
      2.  *Name five things you see.* Out loud. This activates your prefrontal cortex and calms the amygdala.
      
      3.  *Place one hand on your heart, one on your belly.* Breathe slowly: 4 counts in, 6 counts out. This activates the ventral vagal pathway.
      
      4.  *Say:* 
      
      #align(center)[
        _"I am safe in this moment.
        My body is my home.
        I have what I need to face what arises."_
      ]
      
      5.  *Notice the shift.* Even if subtle. Your nervous system is learning that regulation is possible.
    ]
    
    #v(0.5cm)
    
    *Track your practice:* □ Mon □ Tue □ Wed □ Thu □ Fri □ Sat □ Sun
    
    #v(1cm)
    
    This is not "manifesting" or "positive thinking." This is *clinical nervous system regulation*. You are teaching your body a new baseline.
  ],
  image_path: "/assets/generated images/phase1-somatic.jpg",
  layout_style: "bottom"
)
