#import "../template.typ": somatic_page

// PHASE 1 - PAGE 13: SOMATIC MAP - Safety & Grounding
// Using Phase 1 generated image

#somatic_page(
  title: "Where Is Safety in Your Body?",
  body_text: [
    Safety is not just a feeling—it has a *location*. For some, it lives in the belly, a deep rootedness. For others, it's in the feet—solid contact with the ground. For many, safety has never been felt at all, and that absence is itself a sensation worth mapping.
    
    Close your eyes. Scan your body from head to toe. Where do you feel *stable*? Where do you feel *shaky*?
    
    #v(0.5cm)
    
    #align(center)[
      #v(0.5cm)
      #figure(image("/assets/generated images/phase1-somatic.jpg", width: 55%))
      #v(0.5cm)
    ]
    
    *Mark the figure above:*
    - Draw ROOTS where you feel grounded and stable
    - Draw a COCOON or SEED where you feel protected
    - Draw CRACKS or GAPS where safety feels unavailable
    - Draw a GOLDEN THREAD connecting areas that need tending
    
    Remember: There is no "correct" body map. You are simply *witnessing* what is true for you right now.
  ],
  image_path: none,
  layout_style: "bottom"
)
